{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "webfetch": "allow",
    "bash": {
      // Everything not listed below falls through to OpenCode's permissive
      // defaults: the built-in rule list ends in a catch-all "allow", so
      // unmatched commands run without prompting. The "ask" rules below are
      // the only things that still prompt — last matching rule wins, and no
      // "ask" prefix overlaps the "allow" rules above.
      // Read-only shell: listing / inspecting, no side effects.
      "cat *": "allow", "ls *": "allow", "head *": "allow", "tail *": "allow",
      "wc *": "allow", "sort *": "allow", "uniq *": "allow", "less *": "allow",
      "more *": "allow", "date *": "allow", "awk *": "allow", "jq *": "allow",
      "grep *": "allow", "diff *": "allow", "stat *": "allow", "file *": "allow",
      "du *": "allow", "df *": "allow", "which *": "allow", "command -v *": "allow",
      "pwd *": "allow", "env *": "allow", "uname *": "allow", "echo *": "allow",
      "printf *": "allow",

      // Read-only git: never add/commit/push/pull/reset/checkout/merge/stash.
      "git status*": "allow", "git diff*": "allow", "git log*": "allow",
      "git show*": "allow", "git ls-files*": "allow", "git rev-parse*": "allow",
      "git rev-list*": "allow", "git describe*": "allow", "git shortlog*": "allow",
      "git blame*": "allow", "git grep*": "allow", "git reflog*": "allow",
      "git stash list*": "allow", "git tag -l*": "allow", "git tag --list*": "allow",
      "git config --get*": "allow", "git config --list*": "allow", "git config -l*": "allow",
      "git branch -l*": "allow", "git branch --list*": "allow",
      "git branch -a*": "allow", "git branch -vv*": "allow",
      "git remote -v*": "allow",

      // Read-only gh: listing / viewing, no writes (gh api asks below).
      "gh auth status*": "allow", "gh repo view*": "allow", "gh pr list*": "allow",
      "gh pr view*": "allow", "gh pr status*": "allow", "gh issue list*": "allow",
      "gh issue view*": "allow", "gh release list*": "allow", "gh release view*": "allow",
      "gh run list*": "allow", "gh run view*": "allow",

      // Destructive / state-changing: ask. These are the only bash prompts —
      // everything else runs under the default allow.
      "rm": "ask", "rm *": "ask", "rmdir *": "ask", "mv *": "ask", "cp *": "ask", "ln *": "ask",
      "chmod *": "ask", "chown *": "ask", "chgrp *": "ask",
      "sudo *": "ask", "su *": "ask",
      "pacman *": "ask", "yay *": "ask", "paru *": "ask", "systemctl *": "ask",
      "mkfs*": "ask", "dd *": "ask", "fdisk *": "ask", "parted *": "ask",
      "shutdown*": "ask", "reboot*": "ask", "poweroff*": "ask",
      "kill *": "ask", "pkill*": "ask", "killall*": "ask",
      "tee *": "ask", "sed -i*": "ask",
      "docker *": "ask", "podman *": "ask", "kubectl *": "ask",
      "npm install*": "ask", "npm uninstall*": "ask", "npm publish*": "ask", "npx *": "ask",
      "pnpm install*": "ask", "pnpm add*": "ask", "pnpm remove*": "ask",
      "pip install*": "ask", "pip uninstall*": "ask",
      "cargo install*": "ask", "cargo add*": "ask", "go install*": "ask", "go get*": "ask",
      "vi": "ask", "vim": "ask", "nano": "ask", "vi *": "ask", "vim *": "ask", "nano *": "ask",
      "gh api*": "ask", "gh pr create*": "ask", "gh pr merge*": "ask", "gh issue create*": "ask",
      "gh release create*": "ask", "gh repo create*": "ask", "gh auth login*": "ask",
      "git add*": "ask", "git commit*": "ask", "git push*": "ask", "git pull*": "ask",
      "git reset*": "ask", "git checkout*": "ask", "git switch*": "ask", "git restore*": "ask",
      "git merge*": "ask", "git rebase*": "ask", "git revert*": "ask", "git cherry-pick*": "ask",
      "git clean*": "ask", "git rm*": "ask", "git mv*": "ask", "git init*": "ask",
      "git stash pop*": "ask", "git stash apply*": "ask", "git stash push*": "ask",
      "git stash save*": "ask", "git stash drop*": "ask", "git stash clear*": "ask",
      "git branch -d*": "ask", "git branch -D*": "ask", "git branch -m*": "ask",
      "git tag -d*": "ask", "git tag -a*": "ask", "git tag -f*": "ask",
      "git remote add*": "ask", "git remote remove*": "ask", "git remote set-url*": "ask",
      "git config --global*": "ask", "git config --add*": "ask", "git config --unset*": "ask",
      "git submodule update*": "ask", "git submodule add*": "ask"
    }
  },
  "autoupdate": "notify"
}
